AUTH_MODE=per_request
CMR24_BASE_URL=https://cmr24.by/api
# Required only when AUTH_MODE=service_account
CMR24_AUTHKEY=
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
MCP_ALLOWED_ORIGINS=
MCP_SERVICE_ACCOUNT_NETWORKS=127.0.0.0/8,::1/128
# Explicitly grant write/delete/restore only in a trusted deployment.
MCP_DEFAULT_SCOPES=cargo.read
MCP_TRUST_SCOPE_HEADER=false
CMR24_CONNECT_TIMEOUT=5
CMR24_READ_TIMEOUT=30
CMR24_WRITE_TIMEOUT=30
CMR24_POOL_TIMEOUT=5
REFERENCE_CACHE_TTL=3600
REFERENCE_CACHE_SIZE=256
MATCHER_THRESHOLD=0.84
MATCHER_MARGIN=0.08
CONFIRMATION_TTL=180
CONFIRMATION_SECRET=
